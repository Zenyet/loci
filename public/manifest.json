{
  "manifest_version": 3,
  "name": "Loci",
  "short_name": "Loci",
  "version": "0.1.3",
  "description": "Turn your bookmarks into a visual new tab, with fast search, folders and optional everyday tools.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "bookmarks",
    "history",
    "topSites",
    "storage",
    "geolocation"
  ],
  "optional_host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*",
    "https://api.tushare.pro/*",
    "https://cn.bing.com/*",
    "https://www.bing.com/*",
    "https://t0.gstatic.cn/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
