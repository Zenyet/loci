{
  "name": "loci",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Chrome new-tab extension that turns bookmarks into a searchable graph.",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -b && vite build",
    "check": "npm run check:ui && npm run typecheck && npm test && npm run build",
    "check:ui": "node scripts/check-ui-controls.mjs",
    "bench:canvas": "node scripts/bench-canvas.mjs",
    "package:extension": "npm run build && node scripts/package-extension.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.4",
    "jsdom": "^29.0.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.4"
  }
}
